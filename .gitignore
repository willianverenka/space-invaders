# =========================
# Unity (Unity 6) + Rider
# =========================

# ---- OS / Misc ----
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
*.swp
*.swo
*.log

# ---- Unity generated folders ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# ---- Unity build output (common) ----
*.apk
*.aab
*.ipa
*.app
*.exe
*.pdb
*.mdb
*.dll
*.so
*.dylib
*.unitypackage

# ---- Addressables / AssetBundles (only if you generate them into Assets) ----
# If you keep built bundles in-repo, remove these.
**/Assets/AddressableAssetsData/*/AssetBundleCache/
**/Assets/StreamingAssets/aa/
**/AssetBundles/

# ---- Autogenerated solution/project files (Unity regenerates these) ----
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# ---- Unity / Rider / JetBrains IDE files ----
.idea/
*.iml

# Rider-specific caches (often inside project or solution folder)
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/contentModel.xml

# Rider plugin for Unity sometimes creates these
*.DotSettings.user
*.DotSettings

# ---- VS / Code (in case they appear) ----
.vscode/
.vs/

# ---- Unity meta handling ----
# Keep .meta files (DO NOT IGNORE) — they are required for Unity projects.
# Ignore meta files only for generated artifacts (safe):
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Crash / debug dumps ----
sysinfo.txt
*.stackdump

# ---- Packages lock files ----
# Keep these for deterministic installs:
# Packages/packages-lock.json  (recommended to keep)
# If you prefer not to lock packages, uncomment:
# [Pp]ackages/packages-lock.json

# ---- Local/secret config (optional; uncomment if you use them) ----
# *.env
# *.keystore
# *.jks
# *.p12